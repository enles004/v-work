{
  "name": "v-work",
  "version": "0.1.0",
  "description": "MCP server cho VNFITE Work — tiến độ dự án, ticket, thông báo (stdio)",
  "type": "module",
  "bin": {
    "v-work": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/server.ts",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "inspect": "npx @modelcontextprotocol/inspector node dist/cli.js",
    "auth:check": "tsx scripts/check.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "vnfite",
    "vwork",
    "project-tracker",
    "cli"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enles004/v-work.git"
  },
  "homepage": "https://github.com/enles004/v-work#readme",
  "bugs": {
    "url": "https://github.com/enles004/v-work/issues"
  }
}
