# Tuỳ chọn: nếu không dùng `vwork-mcp login`, điền để server tự đăng nhập.
VWORK_USERNAME=
VWORK_PASSWORD=

# Mặc định prod
VWORK_BASE_URL=https://vWork.vnfite.com.vn

# Project id của bảng tiến độ (trang /workplace/tien-do-du-an dùng "eoffice")
VWORK_PROJECT=eoffice

# Cho phép gọi API ghi (PATCH/POST/PUT/DELETE). Mặc định chỉ đọc.
VWORK_ALLOW_WRITE=false

# Cache GET (ms) và timeout request (ms)
VWORK_CACHE_TTL_MS=30000
VWORK_TIMEOUT_MS=20000

# Nơi lưu token (mặc định ~/.config/vwork-mcp/tokens.json)
# VWORK_TOKEN_FILE=
